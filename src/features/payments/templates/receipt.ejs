<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Receipt</title>
    <style>
      @page {
        size: A4;
        margin: 0;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: #fff;
        color: #202020;
        font-family: "Poppins", "Segoe UI", Arial, sans-serif;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        display: flex;
        justify-content: center;
      }

      .page {
        width: 595.92px;
        min-height: 841.92px;
        margin: 0 auto;
        padding: 76px 65px 40px 65px;
        background: #fff;
      }

      .top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        height: 70px;
      }

      .brand {
        width: 280px;
      }

      .brand-logo {
        width: 18px;
        height: 18px;
        display: block;
        margin-bottom: 3px;
      }

      .brand-name {
        font-size: 16px;
        line-height: 18px;
        font-weight: 700;
        color: #303030;
      }

      .brand-address {
        font-size: 11px;
        line-height: 15px;
        color: #777;
      }

      .title {
        margin-top: 4px;
        font-size: 21px;
        line-height: 26px;
        font-weight: 450;
        color: #555555;
        letter-spacing: 0.1px;
        white-space: nowrap;
      }

      hr {
        border: 0;
        border-top: 1px solid #e7e7e7;
        margin: 3px 0 17px;
      }

      .section {
        margin-bottom: 16px;
      }

      .section-title {
        color: #555555;
        font-size: 13.5px;
        line-height: 18px;
        font-weight: 600;
        margin-bottom: 6px;
      }

      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 38px;
      }

      .field {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: 8px;
        min-height: 19px;
        font-size: 11.5px;
        line-height: 17px;
      }

      .label {
        font-weight: 700;
        color: #303030;
      }

      .value {
        color: #303030;
      }

      .divider {
        border-top: 1px solid #e7e7e7;
        margin-top: 14px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11.5px;
        table-layout: fixed;
      }

      th {
        height: 29px;
        padding: 6px 8px;
        background: #e8e8e8;
        text-align: left;
        font-weight: 600;
        color: #111;
        border-bottom: 1px solid #e1e1e1;
      }

      td {
        height: 29px;
        padding: 6px 8px;
        color: #333;
        border-bottom: none;
        vertical-align: middle;
      }

      th:nth-child(1),
      td:nth-child(1) {
        width: 55%;
      }
      th:nth-child(2),
      td:nth-child(2) {
        width: 15%;
        text-align: center;
      }
      th:nth-child(3),
      td:nth-child(3) {
        width: 30%;
        text-align: right;
      }

      .financial {
        margin-top: 1px;
      }

      .financial-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 29px;
        padding: 5px 6px;
        border-bottom: 1px solid #e8e8e8;
        font-size: 11.5px;
      }

      .financial-row strong {
        font-weight: 700;
      }

      .footer {
        text-align: center;
        margin-top: 18px;
        color: #999;
        font-size: 10.5px;
        line-height: 14px;
      }

      @media print {
        .page {
          margin: 0;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <div class="top">
        <div class="brand">
          <img
            class="brand-logo"
            src="https://i.ibb.co/KcFKKwf3/En-Passant-New-Logo.png"
            alt="En-Passant"
            style="width: 32px; height: 32px; margin-bottom: 4px"
          />
          <div class="brand-name">En-Passant</div>
          <div class="brand-address">
            ABES Engineering College, Ghaziabad, UP, India
          </div>
        </div>
        <div class="title">OFFICIAL RECEIPT</div>
      </div>

      <hr />

      <section class="section">
        <div class="section-title">Receipt Details</div>
        <div class="grid">
          <div>
            <div class="field">
              <div class="label">Receipt ID:</div>
              <div class="value"><%= paymentId %></div>
            </div>
            <div class="field">
              <div class="label">Date:</div>
              <div class="value"><%= date %></div>
            </div>
          </div>
        </div>
      </section>

      <div class="divider"></div>

      <section class="section" style="margin-top: 14px">
        <div class="section-title">Customer Information</div>
        <div class="grid">
          <div>
            <div class="field">
              <div class="label">Name:</div>
              <div class="value"><%= userName %></div>
            </div>
          </div>
          <div>
            <div class="field">
              <div class="label">Email:</div>
              <div class="value"><%= userEmail %></div>
            </div>
          </div>
        </div>
      </section>

      <div class="divider"></div>

      <section class="section" style="margin-top: 14px">
        <div class="section-title">Transaction Details</div>
        <table>
          <thead>
            <tr>
              <th>Description</th>
              <th style="text-align: center">Qty</th>
              <th style="text-align: right">Price</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><%= purpose %></td>
              <td style="text-align: center">1</td>
              <td style="text-align: right">₹<%= amount %></td>
            </tr>
          </tbody>
        </table>
      </section>

      <div class="divider"></div>

      <section class="section" style="margin-top: 14px">
        <div class="section-title">Financial Summary</div>
        <div class="financial">
          <div class="financial-row">
            <strong>Total Amount:</strong>
            <strong>₹<%= amount %></strong>
          </div>
          <div class="financial-row">
            <strong>Payment Status:</strong>
            <span style="color: #16a34a; font-weight: 600">Success</span>
          </div>
        </div>
      </section>

      <footer class="footer">
        <div>
          © <%= new Date().getFullYear() %> En-Passant Chess Forum. All rights
          reserved.
        </div>
      </footer>
    </main>
  </body>
</html>
