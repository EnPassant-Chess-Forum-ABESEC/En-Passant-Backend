<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Action Required: Complete Your Application</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #111;
      }

      .wrapper {
        background: #ffffff;
        padding: 48px 16px;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
      }

      /* Logo strip */
      .top {
        padding: 36px 40px 0;
        text-align: left;
      }

      .top img {
        width: 40px;
        height: 40px;
        object-fit: contain;
      }

      /* Body */
      .body {
        padding: 32px 40px 36px;
      }

      .body h1 {
        font-size: 22px;
        font-weight: 600;
        color: #111;
        margin: 0 0 20px;
        line-height: 1.3;
      }

      .body p {
        font-size: 15px;
        line-height: 1.7;
        color: #444;
        margin: 0 0 16px;
      }

      .body p:last-of-type {
        margin-bottom: 0;
      }

      .divider {
        height: 1px;
        background: #f0f0f0;
        margin: 0 40px;
      }

      /* Footer */
      .footer {
        padding: 24px 40px;
        text-align: left;
      }

      .footer p {
        font-size: 12px;
        color: #aaa;
        margin: 0;
        line-height: 1.6;
      }

      .button {
        display: inline-block;
        background: #111;
        color: #ffffff !important;
        font-weight: 500;
        font-size: 14px;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 6px;
        margin: 16px 0 24px;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <div class="top">
          <img
            src="https://i.ibb.co/KcFKKwf3/En-Passant-New-Logo.png"
            alt="En-Passant"
          />
        </div>

        <div class="body">
          <h1>Action Required, <%= userName %>.</h1>

          <p>
            We noticed that you've started your recruitment application for
            <strong>En-Passant</strong>, but you haven't completed the final
            step: the registration fee payment.
          </p>

          <p>
            To unlock access to your department tasks and officially begin the
            recruitment process, please complete the Rs. 40 payment on your
            dashboard.
          </p>

          <a href="<%= applyUrl %>" class="button">Complete Application</a>

          <p>
            If you're facing any issues with the payment, please reach out via
            our
            <a
              href="https://enpassant.co.in/contact"
              style="color: #111; font-weight: 500"
              >Contact Us page</a
            >. We're here to help!
          </p>

          <div style="margin-top: 32px">
            <p>
              Best Regards,<br />
              <strong>En-Passant Core Team</strong>
            </p>
          </div>
        </div>

        <div class="divider"></div>

        <div class="footer">
          <p>
            En-Passant Chess Forum · ABESEC<br />
            © <%= new Date().getFullYear() %> ·
          </p>

          <p style="color: #aaa">support@enpassant.co.in</p>
        </div>
      </div>
    </div>
  </body>
</html>
