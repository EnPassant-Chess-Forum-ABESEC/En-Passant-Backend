<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to En-Passant</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f5f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #374151;
      }

      table {
        border-spacing: 0;
      }

      img {
        border: 0;
        display: block;
      }

      .wrapper {
        width: 100%;
        background: #f5f7fb;
        padding: 40px 20px;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
      }

      .header {
        padding: 40px 30px 24px;
        text-align: center;
        border-bottom: 1px solid #eef2f7;
      }

      .logo {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        border: 2px dashed #d1d5db;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        font-size: 12px;
        background: #fafafa;
      }

      h1 {
        margin: 0;
        font-size: 28px;
        color: #111827;
      }

      .subtitle {
        margin-top: 10px;
        font-size: 16px;
        color: #6b7280;
        line-height: 1.6;
      }

      .content {
        padding: 40px 30px;
      }

      .content p {
        margin: 0 0 18px;
        line-height: 1.7;
        font-size: 15px;
        color: #4b5563;
      }

      .button-container {
        text-align: center;
        margin: 35px 0;
      }

      .button {
        display: inline-block;
        padding: 14px 34px;
        background: #111827;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 15px;
      }

      .footer {
        border-top: 1px solid #eef2f7;
        padding: 24px 30px;
        text-align: center;
        font-size: 13px;
        color: #9ca3af;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .header,
        .content,
        .footer {
          padding: 28px 22px;
        }

        h1 {
          font-size: 24px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <div class="header">
          <img
            src="https://i.ibb.co/KcFKKwf3/En-Passant-New-Logo.png"
            alt="En Passant Logo"
            width="72"
            style="margin: 0 auto 20px"
          />

          <h1>Welcome, <%= userName %>!</h1>

          <div class="subtitle">
            Thanks for joining <strong>En-Passant</strong>. We're excited to
            have you in our chess community.
          </div>
        </div>

        <div class="content">
          <p>
            Whether you're just getting started or already an experienced
            player, you've joined a community built to help you improve,
            compete, and enjoy the game.
          </p>

          <p>
            Explore tournaments, climb the leaderboard, challenge other players,
            and continue sharpening your chess skills.
          </p>

          <div class="button-container">
            <a href="<%= loginUrl %>" class="button"> Go to Dashboard </a>
          </div>

          <p>
            Happy playing,<br />
            <strong>The En-Passant Team</strong>
          </p>
        </div>

        <div class="footer">
          © <%= new Date().getFullYear() %> En-Passant Chess Forum.<br />
        </div>
      </div>
    </div>
  </body>
</html>
