<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Contact Form Query</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

      body {
        margin: 0;
        padding: 0;
        background: #f9f9f9;
        font-family: "Inter", -apple-system, sans-serif;
        color: #111;
      }

      .container {
        max-width: 560px;
        margin: 40px auto;
        background: #ffffff;
        border: 1px solid #eaeaea;
        border-radius: 8px;
        padding: 32px;
      }

      h1 {
        font-size: 20px;
        margin-bottom: 24px;
        color: #111;
      }

      .info-box {
        background: #f4f4f4;
        padding: 16px;
        border-radius: 6px;
        margin-bottom: 24px;
      }

      .info-box p {
        margin: 0 0 8px;
        font-size: 14px;
        color: #333;
      }

      .info-box p:last-child {
        margin-bottom: 0;
      }

      .message-box {
        background: #ffffff;
        border: 1px solid #eaeaea;
        padding: 16px;
        border-radius: 6px;
        font-size: 15px;
        line-height: 1.6;
        color: #444;
        white-space: pre-wrap;
      }

      .footer {
        margin-top: 32px;
        font-size: 12px;
        color: #888;
        border-top: 1px solid #eaeaea;
        padding-top: 16px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>New Query from <%= userName %></h1>
      
      <div class="info-box">
        <p><strong>Name:</strong> <%= userName %></p>
        <p><strong>Email:</strong> <%= userEmail %></p>
        <p><strong>Subject:</strong> <%= subject %></p>
      </div>

      <div class="message-box"><%= message %></div>

      <div class="footer">
        <p>Reply directly to this email to respond to the user.</p>
        <p>Sent from En-Passant Contact Form.</p>
      </div>
    </div>
  </body>
</html>
