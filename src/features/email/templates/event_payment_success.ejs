<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registration Confirmed - <%= eventTitle %></title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");

      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #111;
      }

      .wrapper {
        background: #ffffff;
        padding: 48px 16px;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
      }

      .top {
        padding: 36px 40px 0;
        text-align: left;
      }

      .top img {
        width: 40px;
        height: 40px;
        object-fit: contain;
      }

      .body {
        padding: 32px 40px 36px;
      }

      .body h1 {
        font-size: 22px;
        font-weight: 600;
        color: #111;
        margin: 0 0 16px;
        line-height: 1.3;
      }

      .body p {
        font-size: 15px;
        line-height: 1.7;
        color: #444;
        margin: 0 0 16px;
      }

      .summary-box {
        background: #fafafa;
        border: 1px solid #eaeaea;
        border-radius: 8px;
        padding: 18px 20px;
        margin: 22px 0 26px;
      }

      .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        font-size: 13.5px;
        border-bottom: 1px solid #f0f0f0;
      }

      .summary-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .summary-row:first-child {
        padding-top: 0;
      }

      .summary-label {
        color: #666;
        font-weight: 500;
      }

      .summary-value {
        color: #111;
        font-weight: 600;
      }

      .badge-confirmed {
        display: inline-block;
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
        padding: 2px 8px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .cta-group {
        margin: 28px 0 0;
        text-align: left;
      }

      .cta-group a {
        display: inline-block;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        padding: 11px 24px;
        border-radius: 6px;
        letter-spacing: 0.01em;
      }

      .cta-primary {
        background: #111;
        color: #fff !important;
        margin-right: 12px;
        margin-bottom: 8px;
      }

      .cta-secondary {
        background: #f4f4f4;
        color: #111 !important;
        border: 1px solid #eaeaea;
      }

      .links {
        margin-top: 24px;
      }

      .links a {
        display: block;
        font-size: 11px;
        color: #999;
        margin-top: 6px;
        text-decoration: none;
        word-break: break-all;
      }

      .divider {
        height: 1px;
        background: #f0f0f0;
        margin: 0 40px;
      }

      .footer {
        padding: 24px 40px;
        text-align: left;
      }

      .footer p {
        font-size: 12px;
        color: #aaa;
        margin: 0;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <div class="top">
          <img
            src="https://i.ibb.co/KcFKKwf3/En-Passant-New-Logo.png"
            alt="En-Passant"
          />
        </div>

        <div class="body">
          <h1>Tournament Entry Confirmed, <%= userName %>.</h1>

          <p>
            Your payment for <strong><%= eventTitle %></strong> has been successfully verified.
          </p>

          <p>
            Your tournament entry is officially confirmed. Your official receipt has been generated and is attached to this email as a PDF document.
          </p>

          <div class="summary-box">
            <div class="summary-row">
              <span class="summary-label">Tournament:</span>
              <span class="summary-value"><%= eventTitle %></span>
            </div>
            <% if (typeof sectionName !== 'undefined' && sectionName) { %>
              <div class="summary-row">
                <span class="summary-label">Division:</span>
                <span class="summary-value"><%= sectionName %></span>
              </div>
            <% } %>
            <% if (typeof amount !== 'undefined' && amount) { %>
              <div class="summary-row">
                <span class="summary-label">Fee Paid:</span>
                <span class="summary-value">Rs. <%= amount %></span>
              </div>
            <% } %>
            <div class="summary-row">
              <span class="summary-label">Status:</span>
              <span class="badge-confirmed">Confirmed</span>
            </div>
          </div>

          <div class="cta-group">
            <a href="<%= eventRegisterUrl %>" class="cta-primary">View Registration</a>
            <a href="<%= receiptUrl %>" class="cta-secondary">Download Receipt</a>
          </div>

          <div class="links">
            <a href="<%= eventRegisterUrl %>">Event Page: <%= eventRegisterUrl %></a>
            <a href="<%= receiptUrl %>">Receipt URL: <%= receiptUrl %></a>
          </div>
        </div>

        <div class="divider"></div>

        <div class="footer">
          <p>
            En-Passant Chess Forum · ABESEC<br />
            © <%= typeof year !== 'undefined' ? year : new Date().getFullYear() %> ·
            <a href="mailto:support@enpassant.co.in" style="color: #aaa"
              >support@enpassant.co.in</a
            >
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
