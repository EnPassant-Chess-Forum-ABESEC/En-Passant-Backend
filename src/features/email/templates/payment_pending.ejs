<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Received & Under Review</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #111;
      }

      .wrapper {
        background: #ffffff;
        padding: 48px 16px;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
      }

      /* Logo strip */
      .top {
        padding: 36px 40px 0;
        text-align: left;
      }

      .top img {
        width: 40px;
        height: 40px;
        object-fit: contain;
      }

      /* Body */
      .body {
        padding: 32px 40px 36px;
      }

      .body h1 {
        font-size: 22px;
        font-weight: 600;
        color: #111;
        margin: 0 0 20px;
        line-height: 1.3;
      }

      .body p {
        font-size: 15px;
        line-height: 1.7;
        color: #444;
        margin: 0 0 16px;
      }

      .body p:last-of-type {
        margin-bottom: 0;
      }

      .details-box {
        background: #f9f9f9;
        border: 1px solid #eaeaea;
        border-radius: 6px;
        padding: 20px;
        margin: 24px 0;
      }

      .details-box p {
        margin: 0 0 8px;
        font-size: 14px;
        color: #666;
      }

      .details-box p:last-child {
        margin-bottom: 0;
      }

      .details-box strong {
        color: #111;
        font-weight: 500;
        margin-right: 4px;
      }

      .divider {
        height: 1px;
        background: #f0f0f0;
        margin: 0 40px;
      }

      /* Footer */
      .footer {
        padding: 24px 40px;
        text-align: left;
      }

      .footer p {
        font-size: 12px;
        color: #aaa;
        margin: 0;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <div class="top">
          <img
            src="https://i.ibb.co/KcFKKwf3/En-Passant-New-Logo.png"
            alt="En-Passant"
          />
        </div>

        <div class="body">
          <h1>Payment Received, <%= userName %>.</h1>

          <p>
            We have successfully received your payment details for the
            En-Passant Recruitment. Your submission is currently under review by
            our admins.
          </p>

          <div class="details-box">
            <p>
              <strong>Primary Department:</strong> <%= primaryDept || 'N/A' %>
            </p>
            <p>
              <strong>Secondary Department:</strong> <%= secondaryDept || 'N/A'
              %>
            </p>
          </div>

          <p>
            Once your payment is verified, we will email you your official
            receipt and unlock your application dashboard.
          </p>

          <p>
            If you have any questions, please reach out via our
            <a
              href="https://enpassant.co.in/contact"
              style="color: #111; font-weight: 500"
              >Contact Us page</a
            >.
          </p>
        </div>

        <div class="divider"></div>

        <div class="footer">
          <p>
            En-Passant Chess Forum · ABESEC<br />
            © <%= new Date().getFullYear() %> ·
            <a href="mailto:support@enpassant.co.in" style="color: #aaa"
              >support@enpassant.co.in</a
            >
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
